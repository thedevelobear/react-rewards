{
  "name": "react-rewards",
  "version": "3.0.0",
  "description": "This package lets you easily add micro-interactions to your app and reward users with the rain of confetti, emoji or balloons.",
  "author": "thedevelobear",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/thedevelobear/react-rewards",
  "repository": {
    "url": "git+https://github.com/thedevelobear/react-rewards.git"
  },
  "keywords": [
    "react",
    "react-rewards",
    "confetti",
    "emoji",
    "balloons",
    "cannon",
    "microinteractions",
    "micro-interactions",
    "UI",
    "UX"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "lint:package": "publint --pack npm && attw --pack . --profile esm-only",
    "size": "size-limit",
    "e2e": "pnpm build && pnpm --filter demo build && pnpm --filter demo e2e",
    "bench": "pnpm build && pnpm --filter demo build && pnpm --filter demo bench",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.2",
    "@rslib/core": "1.0.3",
    "@rstest/adapter-rslib": "0.12.4",
    "@rstest/core": "0.12.4",
    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.2.0",
    "typescript": "7.0.2"
  }
}
